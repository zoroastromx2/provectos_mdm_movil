{

"vcpkg-configuration": {
    "overlay-ports": [
      "vcpkg/ports"
    ],
    "overlay-triplets": [
      "vcpkg/triplets"
    ]
  },

"$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
"name": "proyectos-mdm-movil",
"version": "0.1.0",
"description": "GIS tool for creating and managing GeoPackage files and QGIS projects",
"dependencies": [
  {
      "name": "gdal",
      "features": [
        "curl",
        "expat",
        "geos",
        "gif",
        "iconv",
        "jpeg",
        "lerc",
        "libkml",
        "libspatialite",
        "libxml2",
        "lzma",
        "openjpeg",
        "openssl",
        "pcre2",
        "png",
        "postgresql",
        "qhull",
        "webp",
        "zstd"
      ]
   },
  "libzip",
  {
    "name": "sqlite3",
    "default-features": false,
    "features": [ "rtree", "json1", "fts3" ]
  },
  "qgis",
  {
    "name": "qgis",
    "host": true,
    "default-features": false
  },
  "proj"
],
"builtin-baseline": "d6995a0cf3cafda5e9e52749fad075dd62bfd90c"
}

